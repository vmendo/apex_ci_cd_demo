page 2 (
    name: Employees
    alias: EMPLOYEES
    title: Employees
    pageGroup: @training
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employees (
        name: Employees
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select e.ID,e.EMPLOYEE_NUMBER,e.FIRST_NAME||' '||e.LAST_NAME as EMPLOYEE_NAME,d.DEPARTMENT_NAME,e.EMAIL,e.HIRE_DATE,e.STATUS from DEMO_TRN_EMPLOYEES e join DEMO_TRN_DEPARTMENTS d on d.ID=e.DEPARTMENT_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No records match your search.
        }
        actionsMenu {
            chart: false
        }
        advanced {
            savedReportMappingIdentifier: 4105265732175003
        }

        column DEPARTMENT_NAME (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Display Label: Department; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Display Label: Email; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column EMPLOYEE_NAME (
            type: link
            heading {
                heading: Employee
            }
            layout {
                sequence: 30
            }
            link {
                target: {
                    page: 11
                    items: {
                        P11_ID: #ID#
                    }
                    clearCache: 11
                }
                linkText: #EMPLOYEE_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: Display Label: Employee; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: Yes; Authorization Scheme: authenticated application.
            }
        )

        column EMPLOYEE_NUMBER (
            type: plainText
            heading {
                heading: Employee number
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Display Label: Employee number; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column HIRE_DATE (
            type: plainText
            heading {
                heading: Joined
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD Mon YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: Display Label: Joined; Display in Report: Yes; Display in Form: No; Format Mask: DD Mon YYYY; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Display Label: Status; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn DEPARTMENT_NAME (
                sequence: 3
            )

            displayColumn EMAIL (
                sequence: 4
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 2
            )

            displayColumn EMPLOYEE_NUMBER (
                sequence: 1
            )

            displayColumn HIRE_DATE (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 6
            )

        )

    )

    region title-bar (
        name: Employees
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create-record (
        buttonName: CREATE
        label: Add employee
        layout {
            sequence: 10
            region: @title-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
        }
    )

)

