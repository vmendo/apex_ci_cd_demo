page 6 (
    name: Evaluations
    alias: EVALUATIONS
    title: Evaluations
    pageGroup: @training
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region evaluations (
        name: Course feedback
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select v.ID,c.COURSE_NAME,e.FIRST_NAME||' '||e.LAST_NAME as EMPLOYEE_NAME,s.SESSION_CODE,v.SCORE,v.COMMENTS,v.SUBMITTED_AT from DEMO_TRN_EVALUATIONS v join DEMO_TRN_ENROLLMENTS n on n.ID=v.ENROLLMENT_ID join DEMO_TRN_EMPLOYEES e on e.ID=n.EMPLOYEE_ID join DEMO_TRN_SESSIONS s on s.ID=n.SESSION_ID join DEMO_TRN_COURSES c on c.ID=s.COURSE_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No records match your search.
        }
        actionsMenu {
            chart: false
        }
        advanced {
            savedReportMappingIdentifier: 4110850766175007
        }

        column COMMENTS (
            type: plainText
            heading {
                heading: Feedback
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: Display Label: Feedback; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column COURSE_NAME (
            type: plainText
            heading {
                heading: Course
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Display Label: Course; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column EMPLOYEE_NAME (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: Display Label: Employee; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Rating out of 5
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Display Label: Rating (1–5); Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column SESSION_CODE (
            type: plainText
            heading {
                heading: Session
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Display Label: Session; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column SUBMITTED_AT (
            type: plainText
            heading {
                heading: Submitted
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD Mon YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Display Label: Submitted; Display in Report: Yes; Display in Form: No; Format Mask: DD Mon YYYY; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn COMMENTS (
                sequence: 5
            )

            displayColumn COURSE_NAME (
                sequence: 1
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 2
            )

            displayColumn SCORE (
                sequence: 4
            )

            displayColumn SESSION_CODE (
                sequence: 3
            )

            displayColumn SUBMITTED_AT (
                sequence: 6
            )

        )

    )

    region title-bar (
        name: Evaluations
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

)

