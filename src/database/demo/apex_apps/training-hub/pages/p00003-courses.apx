page 3 (
    name: Courses
    alias: COURSES
    title: Courses
    pageGroup: @training
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region courses (
        name: Course catalog
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select c.ID,c.COURSE_CODE,c.COURSE_NAME,k.CATEGORY_NAME,c.DESCRIPTION,c.DURATION_HOURS,c.COURSE_FEE,c.STATUS from DEMO_TRN_COURSES c join DEMO_TRN_CATEGORIES k on k.ID=c.CATEGORY_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No records match your search.
        }
        actionsMenu {
            chart: false
        }
        advanced {
            savedReportMappingIdentifier: 4106509178175004
        }

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Display Label: Category; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column COURSE_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Display Label: Code; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column COURSE_FEE (
            type: plainText
            heading {
                heading: Fee EUR
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Display Label: Fee (EUR); Display in Report: Yes; Display in Form: No; Format Mask: FM999G990D00; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column COURSE_NAME (
            type: link
            heading {
                heading: Course
            }
            layout {
                sequence: 30
            }
            link {
                target: {
                    page: 12
                    items: {
                        P12_ID: #ID#
                    }
                    clearCache: 12
                }
                linkText: #COURSE_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: Display Label: Course; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: Yes; Authorization Scheme: authenticated application.
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Display Label: Description; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column DURATION_HOURS (
            type: plainText
            heading {
                heading: Hours
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: Display Label: Hours; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
            comments {
                comments: Display Label: Status; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn CATEGORY_NAME (
                sequence: 3
            )

            displayColumn COURSE_CODE (
                sequence: 1
            )

            displayColumn COURSE_FEE (
                sequence: 6
            )

            displayColumn COURSE_NAME (
                sequence: 2
            )

            displayColumn DESCRIPTION (
                sequence: 4
            )

            displayColumn DURATION_HOURS (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 7
            )

        )

    )

    region title-bar (
        name: Courses
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create-record (
        buttonName: CREATE
        label: Add course
        layout {
            sequence: 10
            region: @title-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
            }
        }
    )

)

