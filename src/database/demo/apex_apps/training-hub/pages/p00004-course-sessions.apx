            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Display Label: Starts; Display in Report: Yes; Display in Form: No; Format Mask: DD Mon YYYY; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
            comments {
                comments: Display Label: Status; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn CAPACITY (
                sequence: 7
            )

            displayColumn CITY (
                sequence: 6
            )

            displayColumn COURSE_NAME (
                sequence: 1
            )

            displayColumn END_DATE (
                sequence: 4
            )

            displayColumn ENROLLED (
                sequence: 9
            )

            displayColumn INSTRUCTOR (
                sequence: 5
            )

            displayColumn SESSION_CODE (
                sequence: 2
            )

            displayColumn START_DATE (
                sequence: 3
            )

            displayColumn STATUS (
                sequence: 8
            )

        )

    )

    region title-bar (
        name: Course Sessions
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

)

