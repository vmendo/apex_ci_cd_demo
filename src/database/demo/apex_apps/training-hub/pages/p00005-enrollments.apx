page 5 (
    name: Enrollments
    alias: ENROLLMENTS
    title: Enrollments
    pageGroup: @training
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region enrollments (
        name: Employee enrollments
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select n.ID,e.FIRST_NAME||' '||e.LAST_NAME as EMPLOYEE_NAME,c.COURSE_NAME,s.SESSION_CODE,s.START_DATE,n.ENROLLED_AT,n.STATUS,v.SCORE from DEMO_TRN_ENROLLMENTS n join DEMO_TRN_EMPLOYEES e on e.ID=n.EMPLOYEE_ID join DEMO_TRN_SESSIONS s on s.ID=n.SESSION_ID join DEMO_TRN_COURSES c on c.ID=s.COURSE_ID left join DEMO_TRN_EVALUATIONS v on v.ENROLLMENT_ID=n.ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No records match your search.
        }
        actionsMenu {
            chart: false
        }
        advanced {
            savedReportMappingIdentifier: 4109470289175006
        }

        column COURSE_NAME (
            type: plainText
            heading {
                heading: Course
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: Display Label: Course; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column EMPLOYEE_NAME (
            type: link
            heading {
                heading: Employee
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 13
                    items: {
                        P13_ID: #ID#
                    }
                    clearCache: 13
                }
                linkText: #EMPLOYEE_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Display Label: Employee; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: Yes; Authorization Scheme: authenticated application.
            }
        )

        column ENROLLED_AT (
            type: plainText
            heading {
                heading: Enrolled
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD Mon YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: Display Label: Enrolled; Display in Report: Yes; Display in Form: No; Format Mask: DD Mon YYYY; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Rating out of 5
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            comments {
                comments: Display Label: Rating (1–5); Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column SESSION_CODE (
            type: plainText
            heading {
                heading: Session
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Display Label: Session; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column START_DATE (
            type: plainText
            heading {
                heading: Starts
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD Mon YYYY
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Display Label: Starts; Display in Report: Yes; Display in Form: No; Format Mask: DD Mon YYYY; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Display Label: Status; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }

            displayColumn COURSE_NAME (
                sequence: 2
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 1
            )

            displayColumn ENROLLED_AT (
                sequence: 5
            )

            displayColumn SCORE (
                sequence: 7
            )

            displayColumn SESSION_CODE (
                sequence: 3
            )

            displayColumn START_DATE (
                sequence: 4
            )

            displayColumn STATUS (
                sequence: 6
            )

        )

    )

    region title-bar (
        name: Enrollments
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create-record (
        buttonName: CREATE
        label: Add enrollment
        layout {
            sequence: 10
            region: @title-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                clearCache: 13
            }
        }
    )

)

