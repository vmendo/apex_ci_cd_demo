page 9 (
    name: Sales
    alias: SALES
    title: Sales
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales (
        name: Sales
        type: interactiveReport
        source {
            location: localDatabase
            tableName: EBA_DEMO_LOAD_SALES
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 10
                items: {
                    P10_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 9815544767858354
        }

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CREATED (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 16
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: P
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEM_TYPE (
            type: plainText
            heading {
                heading: Item Type
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LAST_UPDATED (
            type: plainText
            heading {
                heading: Last Updated
            }
            layout {
                sequence: 17
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ORDER_DATE (
            type: plainText
            heading {
                heading: Order Date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column ORDER_ID (
            type: plainText
            heading {
                heading: Order ID
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ORDER_PRIORITY (
            type: plainText
            heading {
                heading: Order Priority
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REGION (
            type: plainText
            heading {
                heading: Region
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SALES_CHANNEL (
            type: plainText
            heading {
                heading: Sales Channel
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SHIP_DATE (
            type: plainText
            heading {
                heading: Ship Date
            }
            layout {
                sequence: 9
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column TOTAL_COST (
            type: plainText
            heading {
                heading: Total Cost
                alignment: end
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column TOTAL_PROFIT (
            type: plainText
            heading {
                heading: Total Profit
                alignment: end
            }
            layout {
                sequence: 15
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column TOTAL_REVENUE (
            type: plainText
            heading {
                heading: Total Revenue
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column UNITS_SOLD (
            type: plainText
            heading {
                heading: Units Sold
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column UNIT_COST (
            type: plainText
            heading {
                heading: Unit Cost
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column UNIT_PRICE (
            type: plainText
            heading {
                heading: Unit Price
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Sales
        }

        savedReport 98254 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COUNTRY (
                sequence: 3
            )

            displayColumn CREATED (
                sequence: 16
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ITEM_TYPE (
                sequence: 4
            )

            displayColumn LAST_UPDATED (
                sequence: 17
            )

            displayColumn ORDER_DATE (
                sequence: 7
            )

            displayColumn ORDER_ID (
                sequence: 8
            )

            displayColumn ORDER_PRIORITY (
                sequence: 6
            )

            displayColumn REGION (
                sequence: 2
            )

            displayColumn SALES_CHANNEL (
                sequence: 5
            )

            displayColumn SHIP_DATE (
                sequence: 9
            )

            displayColumn TOTAL_COST (
                sequence: 14
            )

            displayColumn TOTAL_PROFIT (
                sequence: 15
            )

            displayColumn TOTAL_REVENUE (
                sequence: 13
            )

            displayColumn UNITS_SOLD (
                sequence: 10
            )

            displayColumn UNIT_COST (
                sequence: 12
            )

            displayColumn UNIT_PRICE (
                sequence: 11
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @sales
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                clearCache: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sales
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

