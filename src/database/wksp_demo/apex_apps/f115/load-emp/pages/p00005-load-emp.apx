page 5 (
    name: Load Emp
    alias: LOAD-EMP
    title: Load Emp
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region load-emp (
        name: Load Emp
        type: form
        source {
            location: localDatabase
            tableName: EBA_DEMO_LOAD_EMP
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_COMM (
        type: numberField
        label {
            label: Comm
            alignment: right
        }
        layout {
            sequence: 70
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @load-emp
            column: COMM
            dataType: number
        }
    )

    pageItem P5_CREATED (
        type: hidden
        layout {
            sequence: 90
            region: @load-emp
            slot: regionBody
        }
        source {
            formRegion: @load-emp
            column: CREATED
            dataType: date
        }
    )

    pageItem P5_DEPTNO (
        type: selectList
        label {
            label: Deptno
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @eba-demo-load-dept-dname
        }
        layout {
            sequence: 80
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @load-emp
            column: DEPTNO
            dataType: number
        }
    )

    pageItem P5_EMPNO (
        type: hidden
        layout {
            sequence: 10
            region: @load-emp
            slot: regionBody
        }
        source {
            formRegion: @load-emp
            column: EMPNO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_ENAME (
        type: textField
        label {
            label: Ename
            alignment: right
        }
        layout {
            sequence: 20
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @load-emp
            column: ENAME
            dataType: varchar2
        }
    )

    pageItem P5_HIREDATE (
        type: datePicker
        label {
            label: Hiredate
            alignment: right
        }
        layout {
            sequence: 50
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @load-emp
            column: HIREDATE
            dataType: date
        }
    )

    pageItem P5_JOB (
        type: textField
        label {
            label: Job
            alignment: right
        }
        layout {
            sequence: 30
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @load-emp
            column: JOB
            dataType: varchar2
        }
    )

    pageItem P5_LAST_UPDATED (
        type: hidden
        layout {
            sequence: 100
            region: @load-emp
            slot: regionBody
        }
        source {
            formRegion: @load-emp
            column: LAST_UPDATED
            dataType: date
        }
    )

    pageItem P5_MGR (
        type: selectList
        label {
            label: Mgr
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @eba-demo-load-emp-ename
        }
        layout {
            sequence: 40
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @load-emp
            column: MGR
            dataType: number
        }
    )

    pageItem P5_SAL (
        type: numberField
        label {
            label: Sal
            alignment: right
        }
        layout {
            sequence: 60
            region: @load-emp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @load-emp
            column: SAL
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_EMPNO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_EMPNO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_EMPNO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9736133523885139
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-load-emp (
        name: Initialize form Load Emp
        type: formInitialization
        formRegion: @load-emp
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9735395185885140
        }
    )

    process process-form-load-emp (
        name: Process form Load Emp
        type: formAutoRowProcessing
        formRegion: @load-emp
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9735797495885139
        }
    )

)

