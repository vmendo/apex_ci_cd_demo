list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry install-app (
        label: Install App
        icon {
            imageIconCssClasses: fa-cloud-download
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #action$a-pwa-install
            }
        }
        userDefinedAttributes {
            2: a-pwaInstall
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry settings (
        label: Settings
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 1
            parentEntry: @app-user
        }
        link {
            target: {
                page: 20000
            }
        }
        config {
            buildOption: @feature-user-settings
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 40
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry calendar (
        label: Calendar
        icon {
            imageIconCssClasses: fa-calendar-o
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry load-emp-report (
        label: Load Emp Report
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry load-emp-search (
        label: Load Emp Search
        icon {
            imageIconCssClasses: fa-table-search
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry sales (
        label: Sales
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: [
                9
                10
            ]
        }
        link {
            target: {
                page: 9
            }
        }
    )

)

list page-navigation (
    name: Page Navigation

    entry calendar (
        label: Calendar
        icon {
            imageIconCssClasses: fa-calendar-o
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry load-emp-report (
        label: Load Emp Report
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry load-emp-search (
        label: Load Emp Search
        icon {
            imageIconCssClasses: fa-table-search
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

)

list user-settings (
    name: User Settings
    config {
        buildOption: @feature-user-settings
    }

    entry push-notifications (
        label: Push Notifications
        icon {
            imageIconCssClasses: fa-bell-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 20010
            }
        }
        userDefinedAttributes {
            1: Configure whether you want to receive push notifications on this device.
            2: <span class="a-pwaPush--state"></span>
        }
        config {
            buildOption: @feature-push-notifications
        }
    )

)

